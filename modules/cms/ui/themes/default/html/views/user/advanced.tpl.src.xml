<output xmlns="http://www.openrat.de/template" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.openrat.de/template ../../../../../../../template_engine/components/template.xsd">
	<group title="${message:token}">
		<table>
			<row>
				<column header="true">
					<text value="${message:created}"/>
				</column>
				<column header="true">
					<text value="${message:until}"/>
				</column>
				<column header="true">
					<text value="${message:name}"/>
				</column>
				<column header="true">
					<text value="${message:OPERATING_SYSTEM}"/>
				</column>
				<column header="true">
				</column>
			</row>
			<list list="${token}" extract="true">
				<row>
					<column>
						<date date="${create_date}"/>
					</column>
					<column>
						<date date="${expires}"/>
					</column>
					<column>
						<text value="${name}"/>
					</column>
					<column>
						<text value="${platform}"/>
					</column>
					<column class="act-clickable">
						<link type="post" subaction="deltoken" var1="tokenid" value1="${id}">
							<text value="${message:delete}"/>
						</link>
					</column>
				</row>
			</list>
			<row>
				<column class="act-clickable" rowspan="5">
					<link type="dialog" subaction="addtoken">
						<text value="${message:add}"/>
					</link>
				</column>
			</row>
		</table>
	</group>

	<group title="${message:menu_switch}" open="false">
		<part class="act-clickable">
			<link class="btn" subaction="switch" type="edit">
				<text value="${message:user_switch}"/>
			</link>
		</part>
	</group>

</output>
